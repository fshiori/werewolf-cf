{
  "name": "werewolf-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:whitespace": "git diff --check",
    "check:wrangler": "node scripts/check-wrangler-config.mjs",
    "check:d1-schema": "node scripts/check-d1-schema.mjs",
    "check:d1-schema:remote": "node scripts/check-d1-schema.mjs --remote --config wrangler.production.toml",
    "check:production-access": "node scripts/check-production-access.mjs",
    "check:deploy": "npm test && npm run typecheck && npm run check:whitespace && npm run check:d1-schema && npm run check:wrangler -- --production --config wrangler.production.toml",
    "check:stable": "npm run check:deploy && npm run smoke:local:stable",
    "check:production-ready": "npm run check:stable && npm run check:production-access",
    "smoke:local": "node scripts/smoke-production-readonly.mjs --label=Local http://127.0.0.1:8787",
    "smoke:local:ui": "node scripts/smoke-local-ui.mjs --label=Local http://127.0.0.1:8787",
    "smoke:local:write": "node scripts/smoke-production-write.mjs --label=Local http://127.0.0.1:8787 --yes",
    "smoke:local:game": "node scripts/smoke-game-loop.mjs --label=Local http://127.0.0.1:8787 --yes",
    "smoke:local:stable": "node scripts/smoke-local-stable.mjs",
    "smoke:production": "node scripts/smoke-production-readonly.mjs",
    "smoke:production:write": "node scripts/smoke-production-write.mjs",
    "smoke:production:game": "node scripts/smoke-game-loop.mjs",
    "smoke:production:stable": "node scripts/smoke-production-stable.mjs",
    "predeploy": "npm run check:production-ready",
    "deploy": "wrangler deploy --config wrangler.production.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260423.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.14.4"
  }
}
